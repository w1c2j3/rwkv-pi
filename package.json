{
  "name": "rwkv-pi",
  "version": "0.1.0",
  "private": true,
  "description": "RWKV Lightning CUDA continuation client for the pi coding agent.",
  "type": "module",
  "bin": {
    "rwkv-pi": "dist/cli.js",
    "rwkv-pi-harbor": "dist/harbor-cli.js",
    "rwkv-pi-orchestrate": "dist/orchestrate-cli.js",
    "rwkv-pi-step": "dist/step-cli.js",
    "rwkv-pi-doctor": "dist/doctor.js"
  },
  "exports": {
    ".": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "start:source": "node scripts/run-pi-source.mjs dist/cli.js",
    "doctor": "node dist/doctor.js",
    "conformance": "node scripts/conformance.mjs",
    "setup": "bash scripts/install.sh",
    "orchestrate": "node dist/orchestrate-cli.js",
    "step": "node dist/step-cli.js",
    "pi:setup": "node scripts/setup-pi-source.mjs",
    "harness": "node dist/harness-cli.js",
    "harness:source": "node scripts/run-pi-source.mjs dist/harness-cli.js",
    "harbor": "node scripts/run-pi-source.mjs dist/harbor-cli.js",
    "collab": "node scripts/run-pi-source.mjs dist/collaboration-cli.js",
    "dataset": "node dist/dataset-cli.js",
    "tokenize": "node pipeline/compile-lightning-dataset.mjs",
    "smoke": "node scripts/smoke-harness.mjs",
    "smoke:source": "node scripts/run-pi-source.mjs scripts/smoke-harness.mjs",
    "test:source": "node scripts/run-pi-source.mjs --test test/integration.test.mjs test/harness.test.mjs test/harbor.test.mjs test/sandbox.test.mjs test/sandbox-search.test.mjs test/sandbox-mount.test.mjs test/tool-adapter.test.mjs test/token-budget.test.mjs test/loop-guard.test.mjs test/lightning.test.mjs test/stall-detector.test.mjs test/auto-collab.test.mjs test/collaboration.test.mjs test/recovery.test.mjs test/subagents.test.mjs test/subagent-isolation.test.mjs test/orchestrator-extension.test.mjs test/orchestrator-flow.test.mjs test/project-participation.test.mjs test/deepseek-teacher.test.mjs test/step-teacher.test.mjs test/step-teacher-cli.test.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepare": "npm run build",
    "lightning:tokenizer": "node scripts/build-lightning-tokenizer.mjs",
    "lightning:setup": "npm run build && node scripts/setup-lightning.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "ajv": "8.18.0",
    "jsonc-parser": "3.3.1",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3"
  }
}
