# Unmodified rwkv_lightning_cuda backend; formatting and parsing run in the client.
RWKV_BACKEND=lightning
RWKV_BASE_URL=http://127.0.0.1:18771/v1
RWKV_MODEL=rwkv7-g1l-13.3b-restored
RWKV_API_KEY=rwkv-local
# Alternatively unset RWKV_API_KEY:
# RWKV_API_KEY_FILE=/absolute/path/to/rwkv.key
RWKV_CONTEXT_WINDOW=32768
# Reasoning is included. Both CLI and harness clamp this against native prompt counts.
RWKV_MAX_TOKENS=24576
RWKV_TOOL_FORMAT=xml
RWKV_PROMPT_TEMPLATE=xml
RWKV_REPEAT_FAILURE_LIMIT=3
# Optional registered MiSS/NoRA adapter; unset these for the unchanged base model.
# RWKV_ADAPTER_ID=rwkv-pi-nora-v1
# RWKV_ADAPTER_VERSION=version-returned-by-registration
# RWKV_ADAPTER_SCALE=1
# RWKV_PI_SOURCE=/home/chase/GitHub/rwkv-pi/.upstream/pi
# Offline teacher only; never used as an online RWKV fallback.
# TEACHER_BASE_URL=http://127.0.0.1:18772/v1
# TEACHER_MODEL=qwen38fn/qwen3.8-flash-next-iq3_s
# TEACHER_API_KEY_FILE=/absolute/path/to/teacher.key
# TEACHER_CONTEXT_WINDOW=65536
# TEACHER_MAX_TOKENS=8192
# Large local data belongs on Windows F:. See scripts/setup-data-storage.py.
RWKV_PI_DATA_ROOT=/mnt/f/rwkv-pi-data
HF_HOME=/mnt/f/rwkv-pi-data/cache/huggingface
HF_DATASETS_CACHE=/mnt/f/rwkv-pi-data/cache/datasets
PIP_CACHE_DIR=/mnt/f/rwkv-pi-data/cache/pip
