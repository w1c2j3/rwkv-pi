# Unmodified rwkv_lightning_cuda backend; formatting and parsing run in the client.
RWKV_BACKEND=lightning
RWKV_BASE_URL=http://127.0.0.1:8000/v1
RWKV_MODEL=rwkv7
RWKV_API_KEY=rwkv-local
# Alternatively unset RWKV_API_KEY:
# RWKV_API_KEY_FILE=/absolute/path/to/rwkv.key
RWKV_CONTEXT_WINDOW=32768
# Reasoning is included. Both CLI and harness clamp this against native prompt counts.
RWKV_MAX_TOKENS=24576
RWKV_TOOL_FORMAT=xml
RWKV_PROMPT_TEMPLATE=xml
RWKV_REPEAT_FAILURE_LIMIT=3
RWKV_TARGET_FAILURE_LIMIT=3
# 0 runs pi's read/edit/write unchanged; the model-visible prompt and tools are identical either way.
RWKV_TOOL_TOLERANCE=1
# Optional registered MiSS/NoRA adapter; unset these for the unchanged base model.
# RWKV_ADAPTER_ID=my-adapter
# RWKV_ADAPTER_VERSION=version-returned-by-registration
# RWKV_ADAPTER_SCALE=1
# RWKV_PI_SOURCE=/absolute/path/to/rwkv-pi/.upstream/pi
# Optional, independent CLI plugins. Default: RWKV alone, no teacher and no subagents.
RWKV_PLUGINS=none
# RWKV_PLUGINS=strong-model
# RWKV_PLUGINS=subagents
# RWKV_PLUGINS=strong-model,subagents
# Per launch: --plugins none|strong-model|subagents|strong-model,subagents
# Teacher credentials are used only by an explicitly enabled strong-model plugin or teacher CLI.
# TEACHER_BASE_URL=http://127.0.0.1:8001/v1
# TEACHER_MODEL=teacher-model
# TEACHER_API_KEY_FILE=/absolute/path/to/teacher.key
# TEACHER_CONTEXT_WINDOW=65536
# TEACHER_MAX_TOKENS=8192
# Standalone Step teacher (npm run step), independent of the Qwen configuration above.
# STEP_API_KEY_FILE=/absolute/path/to/step.key
# STEP_MODEL=step-3.5-flash
# STEP_BILLING=api
# Use STEP_BILLING=plan only with an active Step Plan; no automatic billing fallback.
# STEP_MAX_TOKENS=16384
# STEP_CONTEXT_WINDOW=256000
# Only step-3.5-flash-2603 accepts STEP_REASONING_EFFORT=high (default) or low.
# Collaboration stall limits:
# RWKV_COLLAB_ERROR_LIMIT=3
# RWKV_COLLAB_MAX_TURNS=48
# RWKV_COLLAB_QWEN_MAX_TURNS=96
# RWKV_COLLAB_SILENCE_MS=180000
# RWKV_COLLAB_PHASE_MS=1800000
# Collaboration traces and participation records are written here; the directory must exist.
RWKV_PI_DATA_ROOT=/absolute/path/to/rwkv-pi-data
